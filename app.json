{
  "expo": {
    "name": "MiAppExpo",
    "slug": "MiAppExpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "miappexpo",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.leobataya.MiAppExpo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1b0e02"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e6e91f1-4a9b-4617-95d7-6f6d2bbb5ec6"
      }
    }
  }
}
